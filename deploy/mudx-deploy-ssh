#!/usr/bin/env python3
import os, re

SEMVER=r'(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)'
COMMAND=re.compile(rf'deploy ([1-9][0-9]*) ({SEMVER}) ([0-9a-f]{{40}}) (sha256:[0-9a-f]{{64}})\Z')
original=os.environ.get('SSH_ORIGINAL_COMMAND','')
if original=='preflight':
 print('mudx-deploy-ready')
 raise SystemExit(0)
match=COMMAND.fullmatch(original)
if not match:
 raise SystemExit('mudx-deploy-ssh: command rejected')
target=os.environ.get('MUDX_DEPLOY_BIN') if os.environ.get('MUDX_TEST_MODE')=='1' else '/usr/local/libexec/mudx-deploy'
os.execv(target,[target,'deploy',match.group(1),match.group(2),match.group(6),match.group(7)])
