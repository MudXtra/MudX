[Unit]
Description=Update MudX documentation container to the verified stable digest
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/opt/mudx-docs/mudx-docs.env

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/mudx-docs
ExecStart=/usr/bin/env /opt/mudx-docs/update-mudx-docs.sh
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/opt/mudx-docs /run/lock
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
