[Unit]
Description=Continuously supervise the single committed MudX container
Requires=docker.service mudx-reconcile.service
After=docker.service mudx-reconcile.service

[Service]
Type=simple
ExecStartPre=/usr/local/libexec/mudx-deploy resume
ExecStart=/usr/local/libexec/mudx-deploy supervise
ExecStop=/usr/local/libexec/mudx-deploy stop
Restart=always
RestartSec=2
TimeoutStopSec=165
KillMode=control-group

[Install]
WantedBy=multi-user.target
